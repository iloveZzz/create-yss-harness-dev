#!/usr/bin/env node
import assert from "node:assert/strict";
import { existsSync, mkdirSync, readdirSync, rmSync, writeFileSync } from "node:fs";
import path from "node:path";
import { spawnSync } from "node:child_process";
import { ROOT } from "./lib/lifecycle-registry.mjs";
import { generateTaskPackageDefaults, validateTaskPackage, validateTaskPackageSet } from "./lib/task-package.mjs";

const scratchDir = "docs/.scratch";
const fixtureDir = `${scratchDir}/_verify-task-package`;
const contractRef = `${fixtureDir}/slice-contract.json`;
const evidenceRef = `${fixtureDir}/evidence.json`;
const maintenanceRef = `${fixtureDir}/maintenance.json`;
const contractFile = path.join(ROOT, contractRef);
const evidenceFile = path.join(ROOT, evidenceRef);
const maintenanceFile = path.join(ROOT, maintenanceRef);
const createdScratch = !existsSync(path.join(ROOT, scratchDir));

const contract = {
  schema_version: 1,
  contract_id: "slice-todo",
  contract_version: 1,
  slice_id: "todo",
  status: "approved",
  current_version: true,
  lifecycle_refs: {},
  readiness: {
    upstream_inputs_current_and_approved: true,
    tactical_design_current_or_not_applicable_recorded: true,
    api_freeze_or_no_api_impact_recorded: true,
    data_architecture_or_no_data_impact_recorded: true,
    ui_inputs_or_no_ui_impact_recorded: true,
    implementation_repositories_and_commands_registered: true,
    allowed_write_paths_registered: true,
    test_seams_and_acceptance_executable: true,
    task_packages_share_contract_version: true,
    blockers: []
  },
  architecture: {},
  frontend: {},
  backend: {},
  testing: {},
  work_units: [
    { id: "work-unit.slice-frontend", role_id: "role.frontend-agent", runtime_id: "runtime.skill-projection", task_package_ref: "work-unit.slice-frontend", contract_id: "slice-todo", contract_version: 1, allowed_write_paths: ["apps/frontend/todo/"] },
    { id: "work-unit.slice-backend", role_id: "role.backend-agent", runtime_id: "runtime.skill-projection", task_package_ref: "work-unit.slice-backend", contract_id: "slice-todo", contract_version: 1, allowed_write_paths: ["apps/backend/todo/"] },
    { id: "work-unit.slice-test", role_id: "role.test-agent", runtime_id: "runtime.skill-projection", task_package_ref: "work-unit.slice-test", contract_id: "slice-todo", contract_version: 1, allowed_write_paths: ["tests/todo/"] }
  ]
};

const maintenance = {
  schema_version: 1,
  intensity: "L3",
  classification_reason: "四角色 Harness Agent 行为合同替换场景",
  triggers: ["lifecycle-gate", "ticket-state", "core-validator"],
  changed_assets: ["scenario-fixture"],
  verification_evidence: [
    { kind: "red", command: "scenario", result: "pass" },
    { kind: "green", command: "scenario", result: "pass" },
    { kind: "refactor", command: "scenario", result: "pass" },
    { kind: "pressure-scenario", command: "scenario", result: "pass" },
    { kind: "fresh-verification", command: "scenario", result: "pass" },
    { kind: "formal-independent-review", command: "scenario", result: "pass" }
  ],
  review_mode: "formal-independent",
  escalation: "none"
};

function writeFixtures() {
  mkdirSync(path.dirname(contractFile), { recursive: true });
  writeFileSync(contractFile, JSON.stringify(contract));
  writeFileSync(evidenceFile, JSON.stringify({ ok: true }));
  writeFileSync(maintenanceFile, JSON.stringify(maintenance));
}

function packageBase(roleId, taskId, workUnitId, kind, contractFields, stageId) {
  writeFixtures();
  return generateTaskPackageDefaults(roleId, {
    task_id: taskId,
    work_unit_id: workUnitId,
    actor_id: roleId + ".instance-1",
    ...(stageId ? { stage_id: stageId } : {}),
    runtime_id: "runtime.skill-projection",
    execution_state: "Worker",
    workflow_status: "not-started",
    contract: { kind, contract_id: kind + "-" + taskId, contract_version: 1, status: "issued", contract_ref: "docs/process/lifecycle-registry.yaml", ...contractFields },
    inputs: ["CONTEXT.md"],
    objective: "执行有界 Harness Agent 工作单元",
    allowed_write_paths: ["docs/.scratch/"],
    forbidden_actions: ["不得越过 Orchestrator 门禁"],
    expected_outputs: ["结构化工作结果"],
    expected_evidence_files: [evidenceRef],
    verification_commands: ["scripts/verify-template"],
    verification_results: [],
    downstream_consumers: ["role.harness-orchestrator"],
    convergence: { parent_work_unit: workUnitId, convergence_ref: "checkpoint:test", conflict_escalation: "返回 Orchestrator" }
  });
}

function lifecyclePackage() {
  return packageBase("role.architecture-agent", "task-tactical-design", "work-unit.tactical-design", "lifecycle-work-unit", {
    lifecycle_ref: "docs/process/lifecycle-registry.yaml",
    artifact_refs: ["artifact.tactical-design"],
    gate_refs: ["gate.tactical-design-approved"],
    contract_id: "lifecycle-tactical-design"
  }, "stage.tactical-design");
}

function templatePackage() {
  return packageBase("role.harness-orchestrator", "task-maintenance", "work-unit.intensity-aware-verification", "template-maintenance", {
    maintenance_ref: maintenanceRef,
    contract_id: "template-maintenance"
  });
}

function slicePackage(roleId, taskId, workUnitId, writePath) {
  writeFixtures();
  return generateTaskPackageDefaults(roleId, {
    task_id: taskId,
    work_unit_id: workUnitId,
    actor_id: roleId + ".instance-1",
    stage_id: "stage.slice-implementation",
    runtime_id: "runtime.skill-projection",
    execution_state: "Worker",
    workflow_status: "not-started",
    contract: { kind: "slice-implementation", contract_id: contract.contract_id, contract_version: contract.contract_version, status: "issued", contract_ref: contractRef, slice_contract_ref: contractRef },
    inputs: ["CONTEXT.md"],
    objective: "实现 Todo 垂直切片",
    allowed_write_paths: [writePath],
    forbidden_actions: ["不得修改合同"],
    expected_outputs: ["实现代码", "测试证据"],
    expected_evidence_files: [evidenceRef],
    verification_commands: ["scripts/verify-template"],
    verification_results: [],
    downstream_consumers: ["role.test-agent"],
    convergence: { parent_work_unit: "work-unit.slice-implementation", convergence_ref: "checkpoint:todo", conflict_escalation: "返回 Orchestrator" }
  });
}

function completedResult(pkg, overrides = {}) {
  return {
    result_schema: "workflow-execution-result-v1",
    work_unit: pkg.work_unit_id,
    workflow_reference: "workflow:" + pkg.task_id,
    result: "completed",
    skill: "harness-orchestrator",
    changed_files: [],
    evidence_refs: [evidenceRef],
    deferred_seams: [],
    drift: [],
    violation: [],
    new_impacts: [],
    stale_candidates: [],
    next_route: "work-unit.slice-contract",
    blocking_signals: [],
    ...overrides
  };
}

function mustFail(mutator, pattern, label, factory = () => lifecyclePackage()) {
  const value = factory();
  mutator(value);
  assert.throws(() => validateTaskPackage(value), pattern, label);
}

try {
  const tactical = lifecyclePackage();
  const maintenance = templatePackage();
  const frontend = slicePackage("role.frontend-agent", "task-frontend", "work-unit.slice-frontend", "apps/frontend/todo/");
  const backend = slicePackage("role.backend-agent", "task-backend", "work-unit.slice-backend", "apps/backend/todo/");
  const testing = slicePackage("role.test-agent", "task-test", "work-unit.slice-test", "tests/todo/");
  testing.execution_state = "Verifier";
  [tactical, maintenance, frontend, backend, testing].forEach((pkg) => validateTaskPackage(pkg));
  validateTaskPackageSet([frontend, backend, testing]);

  const completed = lifecyclePackage();
  completed.workflow_status = "resolved";
  completed.verification_results = [{ command: "scripts/verify-template", exit_code: 0, executed_at: "now", evidence_ref: evidenceRef }];
  completed.result = completedResult(completed);
  validateTaskPackage(completed);

  const validFile = path.join(ROOT, fixtureDir, "valid.json");
  mkdirSync(path.dirname(validFile), { recursive: true });
  writeFileSync(validFile, JSON.stringify(tactical));
  for (const cli of ["scripts/verify-digital-human-task-package", "scripts/verify-subagent-task-package"]) {
    const result = spawnSync(process.execPath, [path.join(ROOT, cli), validFile], { encoding: "utf8" });
    assert.equal(result.status, 0, result.stderr);
  }
  rmSync(validFile, { force: true });

  mustFail((value) => { value.contract.kind = "unknown"; }, /未知 contract.kind|not one of/, "unknown-contract-kind");
  mustFail((value) => { value.contract.slice_contract_ref = contractRef; }, /不得携带专项合同引用/, "lifecycle-slice-ref");
  mustFail((value) => { delete value.contract.lifecycle_ref; }, /lifecycle_ref/, "lifecycle-missing-ref");
  mustFail((value) => { value.contract.kind = "slice-implementation"; delete value.contract.slice_contract_ref; }, /slice_contract_ref/, "slice-missing-ref");
  mustFail((value) => { value.contract.kind = "template-maintenance"; delete value.contract.maintenance_ref; }, /maintenance_ref/, "maintenance-missing-ref");
  mustFail((value) => { value.contract.status = "stale"; }, /stale 任务包必须暂停/, "stale-not-paused");
  mustFail((value) => { value.runtime_id = "runtime.unknown"; }, /未知 runtime_id/, "unknown-runtime");
  mustFail((value) => { value.skill_source.core_skills = ["forbidden-skill"]; }, /core_skills 必须与角色注册表完全一致/, "skill-source-mismatch");
  mustFail((value) => { value.stage_id = "stage.tactical-design"; }, /未覆盖 stage_id/, "role-stage-mismatch", () => slicePackage("role.frontend-agent", "task-stage", "work-unit.slice-frontend", "apps/frontend/todo/"));
  mustFail((value) => { value.result = { result: "blocked", changed_files: ["docs/../secret.txt"] }; }, /超出 allowed_write_paths|越出仓库/, "write-path-traversal");
  mustFail((value) => { value.execution_state = "Reviewer"; value.review_context = { implementation_actor_id: value.actor_id }; }, /不同 actor_id/, "reviewer-implementer-conflict");
  mustFail((value) => { value.workflow_status = "resolved"; value.verification_results = [{ command: "scripts/verify-template", exit_code: 0, executed_at: "now", evidence_ref: evidenceRef }]; value.result = completedResult(value, { new_impacts: ["api-change"] }); }, /new_impacts 必须为空/, "completed-new-impact");
  mustFail((value) => { value.workflow_status = "resolved"; value.result = completedResult(value); }, /verification_results/, "resolved-without-verification");

  process.stdout.write("四角色 Harness Agent 任务包压力场景验证通过\n");
} finally {
  rmSync(path.join(ROOT, fixtureDir), { recursive: true, force: true });
  const scratchRoot = path.join(ROOT, scratchDir);
  if (createdScratch && existsSync(scratchRoot) && readdirSync(scratchRoot).length === 0) {
    rmSync(scratchRoot, { recursive: true, force: true });
  }
}
